# ============================================================
# 智能快寄柜项目 · 全局忽略规则（作用于后端 + 前端 + 工具链）
# ============================================================

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.code-workspace

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 敏感配置（禁止入库） ----------
.env
.env.*
!.env.example
configs/*.local.yaml
configs/*.local.yml
# 后端本地明文配置（含数据库密码/JWT secret，禁止入库）
**/config/config.yaml
**/config/config.yml
config.yaml
config.yml
**/config/*.secret.*
**/*secret*.json
**/credentials*.json
*.pem
*.key

# ---------- Go 后端 ----------
# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
build/
# 测试与覆盖率
*.test
*.out
coverage.txt
coverage.html
# 依赖目录（如采用 vendor 则需移除本行）
vendor/
# pprof / trace / 火焰图采样产物（工单08）
*.prof
*.pprof
*.trace
cpu.pprof
mem.pprof
flamegraph.svg
*.folded

# ---------- 前端 Vue3 + Vite ----------
node_modules/
# Vite 构建
dist/
.vite/
*.local
# 数字人子模块（工单07）依赖与缓存
.pnpm-store/
cache/

# ---------- 持续分析 / 监控 ----------
pyroscope-data/
parca-data/

# ---------- 临时 / 中间产物 ----------
temp/
tmp/
.tmp/
*.tmp
*.bak
*.orig

# ---------- Git ----------
# 保留空目录占位
!**/.gitkeep
